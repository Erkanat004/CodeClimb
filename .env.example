# Copy to .env.local for local use; never commit credentials.
# In production provide these via Docker --env-file .env.production.
APP_ORIGIN=http://localhost:5173
CODE_CLIMB_PUBLIC=0
ACCOUNT_PORT=3001
ACCOUNT_HOST=127.0.0.1
SQLITE_PATH=data/code-climb.sqlite
ADMIN_USERNAME=Admin996
# scrypt hash only. The supplied initial password is not stored in this template.
ADMIN_PASSWORD_HASH=
OTP_SECRET=
PROXY_TOKEN=
# file: local test messages, never real email. Production MUST use resend.
MAIL_MODE=file
MAIL_PREVIEW_DIR=data/mail-preview
RESEND_API_KEY=
MAIL_FROM=
# Optional competition judge. Keep the judge on a private network.
JUDGE_URL=
JUDGE_TOKEN=
# Required only for AppLixir rewarded hints in production.
APPLIXIR_WEBHOOK_SECRET=
# Production Caddy domain; omit https:// here.
DOMAIN=
